# Copier ce fichier vers .env et remplacer les valeurs :
#   cp .env.example .env
#
# Le .env ne doit JAMAIS être commité (il contient les clés d'API DNS).

# OVH API (DNS-01) — https://eu.api.ovh.com/createToken/
OVH_APPLICATION_KEY=votre_application_key
OVH_APPLICATION_SECRET=votre_application_secret
OVH_CONSUMER_KEY=votre_consumer_key
OVH_ENDPOINT=ovh-eu

# Gandi API (DNS-01) — https://admin.gandi.net
GANDIV5_PERSONAL_ACCESS_TOKEN=votre_token_gandi

# Domaine OVH
DOMAIN=votre-domaine-ovh.fr
DOMAIN_REGEX=^.+\.votre\-domaine\-ovh\.fr$$

# Domaine Gandi
DOMAIN_GANDI=votre-domaine-gandi.fr
DOMAIN_GANDI_REGEX=^.+\.votre\-domaine\-gandi\.fr$$

# Hôte simple (TLS challenge, pas de wildcard ni d'API DNS) — optionnel
DOMAIN_SIMPLE=sous-domaine.autre-registrar.fr

# Si vous n'utilisez qu'un seul provider, laissez les variables de l'autre vides.
#
# DOMAIN_REGEX matche tous les sous-domaines : échapper les . et les - avec \,
# et terminer par $$ (le $ seul serait interprété par Docker Compose).
#   example.com     -> ^.+\.example\.com$$
#   mon-site.fr     -> ^.+\.mon\-site\.fr$$
